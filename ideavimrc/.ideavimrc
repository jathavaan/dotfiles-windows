let g:WhichKeyDesc_goto_call   = "<leader>gH call hierarchy"
let g:WhichKeyDesc_goto_mhier  = "<leader>gm method hierarchy"
let g:WhichKeyDesc_goto_struct = "<leader>go file structure"
