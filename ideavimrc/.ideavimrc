let g:WhichKeyDesc_goto_fwd    = "<leader>gn forward"

let g:WhichKeyDesc_debug_toggle = "<leader>dt toggle breakpoint"
let g:WhichKeyDesc_debug_view   = "<leader>db view breakpoints"
let g:WhichKeyDesc_debug_ctx    = "<leader>ds debug under cursor"
let g:WhichKeyDesc_debug_choose = "<leader>df choose debug config"
let g:WhichKeyDesc_debug_cont   = "<leader>dc continue"
let g:WhichKeyDesc_debug_over   = "<leader>do step over"
let g:WhichKeyDesc_debug_into   = "<leader>di step into"
let g:WhichKeyDesc_debug_smart  = "<leader>dI smart step into"
let g:WhichKeyDesc_debug_out    = "<leader>du step out"
let g:WhichKeyDesc_debug_cursor = "<leader>dr run to cursor"
let g:WhichKeyDesc_debug_eval   = "<leader>de evaluate"
let g:WhichKeyDesc_debug_watch  = "<leader>dw add to watch"
let g:WhichKeyDesc_debug_mute   = "<leader>dm mute breakpoints"
let g:WhichKeyDesc_debug_clear  = "<leader>dC remove all breakpoints"
let g:WhichKeyDesc_debug_pop    = "<leader>dp pop frame"

let g:WhichKeyDesc_run_last   = "<leader>rr run (Shift+F10)"
let g:WhichKeyDesc_run_debug  = "<leader>rd debug (Shift+F9)"
let g:WhichKeyDesc_run_choose = "<leader>rc choose config"
let g:WhichKeyDesc_run_ctx    = "<leader>rs run under cursor"
let g:WhichKeyDesc_run_stop   = "<leader>rk stop"
let g:WhichKeyDesc_run_class  = "<leader>rt run class"
let g:WhichKeyDesc_run_failed = "<leader>rf rerun failed tests"

let g:WhichKeyDesc_code_rename  = "<leader>lr rename"
let g:WhichKeyDesc_code_action  = "<leader>la intention actions"
let g:WhichKeyDesc_code_format  = "<leader>lf reformat"
let g:WhichKeyDesc_code_imports = "<leader>lo optimize imports"
let g:WhichKeyDesc_code_diag    = "<leader>ld error description"
let g:WhichKeyDesc_code_refac   = "<leader>lR refactor menu"
let g:WhichKeyDesc_code_gen     = "<leader>lg generate"
let g:WhichKeyDesc_code_insp    = "<leader>li inspect code"

let g:WhichKeyDesc_find_files  = "<leader>ff files"
let g:WhichKeyDesc_find_grep   = "<leader>fg find in path"
let g:WhichKeyDesc_find_recent = "<leader>fr recent files"
let g:WhichKeyDesc_find_bufs   = "<leader>fb switcher"
